/*
 * CDC-ACM 노드를 만들고 **콘솔·셸을 그것으로 돌린다.**
 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * ── 원칙 (2026-11-06 사용자 확정) ────────────────────────────────────
 *   main 은 USB 다. 안 되면 UART 1개만 써서 들여다본다.
 *
 * 그래서 이 오버레이가 chosen 을 CDC 로 지정하고, 진단용으로
 * diag-uart.overlay (chosen 을 uart2 로 되돌림) 를 따로 둔다.
 *
 * ⚠ 열거 전 로그는 터미널을 열 때까지 보이지 않는다. LOG_MODE_DEFERRED 라
 *   버퍼에 쌓이고 백엔드가 붙은 뒤 쏟아진다 (그래서 prj.conf 가
 *   LOG_BUFFER_SIZE 를 16384 로 올려 둔다). 부팅이 열거 전에 죽으면
 *   아무것도 안 보이므로, src/moru_mark.c 의 동기 마커는 chosen 과
 *   무관하게 **uart2 에 직접** 찍는다 — 그것이 유일한 초기 관측 수단이다.
 *
 * ⚠ CDC 의 poll_out 은 링버퍼가 차면 **버린다** (블록하지 않는다 —
 *   usbd_cdc_acm.c:1014, flow_ctrl 이 DT hw-flow-control 에서 오고 우리
 *   노드엔 없으므로 false). 그래서 셸 백엔드를 폴링 모드로 유지할 수 있고
 *   CONFIG_SHELL_BACKEND_SERIAL_CHECK_DTR(인터럽트 모드 전용) 가 필요 없다.
 *   대가는 터미널을 열기 전 출력이 버려지는 것 — 열고 엔터를 치면 된다.
 */

#include <zephyr/dt-bindings/interrupt-controller/arm-gic.h>

/*
 * ⚠ uart2 인터럽트를 레벨 트리거로 바로잡는다.
 *
 * 인트리 rk3568.dtsi:81 이 IRQ_TYPE_EDGE 로 선언했으나 RK356x 의 UART 는
 * 레벨 트리거다 (Linux rk356x-base.dtsi 는 IRQ_TYPE_LEVEL_HIGH 를 쓴다).
 * intc_gicv3.c:208 의 `if (flags & IRQ_TYPE_EDGE)` 가 이 값을 실제로 GIC
 * ICFGR 에 쓰므로, 틀린 채로 두면 SPI 118 이 edge 로 설정된다.
 *
 * 이 보드에서 UART 인터럽트를 켜는 것은 이 앱이 처음이다 — 기존 세 앱은
 * CONFIG_SHELL 이 없어 이 경로를 쓴 적이 없다.
 *
 * 인트리 dtsi 대신 앱 오버레이에서 고친다. 보드 DTS 는 지금 유일하게
 * 부팅하는 파일이라 건드리지 않는다.
 */
&uart2 {
	interrupts = <GIC_SPI 118 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
};

&zephyr_udc0 {
	/* 셸·로그 (chosen zephyr,console / zephyr,shell-uart) */
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};

	/*
	 * OTA 데이터 포트 (2026-11-06).
	 *
	 * 왜 두 번째가 필요한가: 셸이 cdc_acm_uart0 를 독점하므로 펌웨어
	 * 바이너리를 받을 통로가 없다. 같은 포트로 받으려면 셸을 멈추고 raw
	 * 모드로 바꿔야 하는데, 그러면 전송 중 상태를 물어볼 수단이 사라진다.
	 * 인스턴스를 하나 더 두면 호스트에 포트가 둘 생겨
	 *   /dev/cu.usbmodem…  (셸)      ← 사람이 쓴다
	 *   /dev/cu.usbmodem…  (데이터)  ← cat zephyr.bin > 로 쏟아붓는다
	 * 가 되고, 전송 중에도 셸로 진행 상황을 볼 수 있다.
	 *
	 * 비용: USB 인터페이스 2개·엔드포인트 3개(notification IN + bulk IN +
	 * bulk OUT)가 늘어난다. 두 CDC 가 EP1~EP4 만 쓰므로 DT 의
	 * num-bidir-endpoints = <8> 로 충분하다 (HW 는 16).
	 */
	cdc_acm_uart1: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};
