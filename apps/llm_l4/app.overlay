/*
 * L1 — 모델 가중치 창(창 밖 DRAM)을 MMU 에 연다.
 *
 * ⚠ C 코드가 0줄이다. arm64 가 DT 의 zephyr,memory-region 노드를 부팅 때
 *   평면 매핑한다 (arch/arm64/core/mmu.c:907 의 mmu_dt_regions).
 *   단 zephyr,memory-attr 속성이 있어야 항목이 생긴다 —
 *   MMU_REGION_DT_FLAT_ENTRY_FROM_DT 가 IF_ENABLED 로 감싸고 있다
 *   (include/zephyr/arch/arm64/arm_mmu.h:236-242). 빼면 조용히 안 매핑된다.
 *
 * 주소 0x60000000 은 docs/llm-hub-test-plan.md 가 고정한 값이다.
 * 실기 U-Boot fatload 와 QEMU -device loader 가 같은 주소를 쓴다.
 *   sram0        0x40000000 + 128 MB → 0x48000000 까지
 *   OTA 적재     0x50000000 (sdcard/boot.cmd 의 ota_addr) — 겹치지 않는다
 *   모델 창      0x60000000 + 640 MB → 0x88000000 까지
 *   DRAM 끝      0xC0000000 (2 GB) — 안에 있다
 *
 * 2 MB 정렬이 중요하다. set_mapping(mmu.c:372) 은 정렬이 맞을 때만 큰 블록을
 * 쓰므로, 정렬이 깨지면 4 KB 페이지로 깔려 MAX_XLAT_TABLES 를 넘기고
 * 콘솔이 올라오기 전에 죽는다. 0x60000000/640 MB 는 둘 다 2 MB 정렬이라
 * L2 블록 320개 = 추가 테이블 2개로 끝난다.
 */
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm64.h>

/ {
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		model_blob: memory@60000000 {
			compatible = "zephyr,memory-region";
			reg = <0x0 0x60000000 0x0 0x28000000>;	/* 640 MiB */
			zephyr,memory-region = "MODEL_BLOB";
			zephyr,memory-attr = <DT_MEM_ARM64_MMU_NORMAL>;
		};
	};
};
